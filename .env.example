# Backend environment variables — copy to .env and fill in values
# NEVER commit .env to git

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/claude_tracker?retryWrites=true&w=majority

# JWT secret for admin sessions (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_32_plus_random_hex_chars

# Admin bootstrap password (used only for first-time setup via /api/auth/bootstrap)
ADMIN_BOOTSTRAP_SECRET=replace_with_strong_random_string

# CORS: comma-separated allowed origins for dashboard
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Port (Render sets this automatically)
PORT=4000

# Node environment
NODE_ENV=production


# IANA reporting timezone. All stored times remain UTC.
REPORTING_TIMEZONE=Asia/Kolkata

# Do not use the synthetic QA database for real collected reports.
DATA_MODE=collected

# Optional overrides to the bundled official model catalog (USD per million tokens).
# Provide all four categories for any overridden/new model. Unknown IDs stay unpriced.
# This is an API-equivalent estimate, never Max subscription billing.
MODEL_RATES_JSON={}

# Optional pricing provenance displayed beside API-equivalent estimates.
MODEL_RATES_SOURCE=https://platform.claude.com/docs/en/about-claude/pricing
MODEL_RATES_VERIFIED_AT=
MODEL_RATES_BASIS=Standard API speed; five-minute cache writes. Not subscription billing.
